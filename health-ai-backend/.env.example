# Keep real values in .env locally or your deployment platform's secret variables.

# Stage 3 symptom-clarification chat. The browser never receives GOOGLE_API_KEY.
SYMPTOM_CHAT_GEMINI_MODEL=gemini-3.1-flash-lite
SYMPTOM_CHAT_MAX_OUTPUT_TOKENS=700
# Use a unique high-entropy secret in any deployed environment. It signs the
# short-lived, stateless Stage 3 plan and Stage 4 approval tokens.
SYMPTOM_CHAT_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-24-characters

# Optional curated Neo4j knowledge graph. Never put patient, report, or session data in it.
NEO4J_ENABLED=false
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-secret
NEO4J_DATABASE=neo4j

# Remains false until each evidence record has qualified clinical approval.
KNOWLEDGE_GRAPH_RUNTIME_ENABLED=false

# Must exactly match STAGE4_VALIDATION_SECRET in Spring Boot. FastAPI signs
# only the post-validation result; Spring persists the signed payload itself.
STAGE4_VALIDATION_SECRET=replace-with-a-shared-long-random-secret
