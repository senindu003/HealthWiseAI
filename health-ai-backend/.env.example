# Keep real values in .env locally or your deployment platform's secret variables.

# Optional curated Neo4j knowledge graph. Never put patient, report, or session data in it.
NEO4J_ENABLED=false
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-secret
NEO4J_DATABASE=neo4j

# Remains false until each evidence record has qualified clinical approval.
KNOWLEDGE_GRAPH_RUNTIME_ENABLED=false
